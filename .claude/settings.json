{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/codex/session-start.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Loading governance context for {{PROJECT_NAME}}"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/codex/user-prompt-submit.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Checking project governance context for the user request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/claude/stop-chat-summary.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Checking the implementation handoff format"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/claude/post-edit-framework-check.ps1"
            ],
            "timeout": 20,
            "statusMessage": "Checking index consistency after framework edits"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/claude/pre-compact-snapshot.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Saving PM role transitions before compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{{PROJECT_ROOT_POSIX}}/能力资产/tools/hooks/claude/pre-write-guard.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Checking sensitive writes involving secrets"
          }
        ]
      }
    ]
  }
}
